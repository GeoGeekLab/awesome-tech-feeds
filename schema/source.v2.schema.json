{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GeoGeekLab/awesome-tech-feeds/main/schema/source.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "language",
    "website",
    "description",
    "feeds",
    "topics",
    "traits",
    "curation",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "kind": {
      "enum": [
        "individual",
        "company",
        "research",
        "community",
        "publication",
        "project"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 500
    },
    "feeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "format",
          "role",
          "official"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "format": {
            "enum": [
              "rss",
              "atom",
              "jsonfeed",
              "unknown"
            ]
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
          },
          "official": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "recommended_for": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "admission_basis",
        "reviewer",
        "reviewed_at",
        "review_after"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 60,
          "maxLength": 800
        },
        "admission_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "first-party-engineering",
              "first-party-technical",
              "independent-practitioner",
              "independent-analysis",
              "primary-research",
              "official-project",
              "technical-community",
              "technical-publication"
            ]
          }
        },
        "reviewer": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "review_after": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_by",
        "added_at",
        "evidence"
      ],
      "properties": {
        "added_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "added_at": {
          "type": "string",
          "format": "date"
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "url"
            ],
            "properties": {
              "type": {
                "enum": [
                  "identity",
                  "feed",
                  "representative-work",
                  "about",
                  "repository"
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "note": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "maintainers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "redirect_to": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "retired"
          }
        }
      },
      "then": {
        "required": [
          "redirect_to"
        ]
      }
    }
  ]
}
